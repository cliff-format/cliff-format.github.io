type: label

<hero-announce>
source: "CLIFF 1.1 已发布"
target: "CLIFF 1.1 ist da"
status: translated

<hero-announce-link>
source: "阅读更新日志"
target: "Änderungsprotokoll lesen"
status: translated

<hero-title-1>
source: "上下文，"
target: "Kontext,"
status: translated

<hero-title-2>
source: "就是格式。"
target: "ist das Format."
status: translated

<hero-lede>
source: "一个面向完整本地化生命周期的逐行工作文件。家族、分组与条目的上下文随字符串流动——译者读得懂，模型改得动，校验一次通过。"
target: "Eine zeilenweise Arbeitsdatei für den gesamten Lokalisierungszyklus. Kontext von Clan, Gruppe und Eintrag reist mit jedem String — lesbar für Übersetzer, bearbeitbar für Modelle, in einem Durchlauf validiert."
type: description
status: translated

<hero-action-spec>
source: "阅读规范"
target: "Spezifikation lesen"
