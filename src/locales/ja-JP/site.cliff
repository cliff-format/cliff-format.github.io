CLIFF 1.1
namespace: cliff
clan: site
source-language: zh-CN
target-language: ja-JP
title: "CLIFF site copy"

[nav]
type: label

<nav-brand-home>
source: "CLIFF 首页"
target: "CLIFF ホーム"
status: translated

<nav-main>
source: "主导航"
target: "メインナビゲーション"
status: translated

<nav-format>
source: "格式"
target: "フォーマット"
status: translated

<nav-features>
source: "特性"
target: "特徴"
status: translated

<nav-lifecycle>
source: "生命周期"
target: "ライフサイクル"
status: translated

<nav-ecosystem>
source: "生态"
target: "エコシステム"
status: translated

<nav-github>
source: "在 GitHub 上查看 CLIFF"
target: "GitHub で CLIFF を見る"
status: translated

<nav-theme>
source: "深色模式"
target: "ダークモード"
status: translated

<nav-skip>
source: "跳到正文"
target: "本文へスキップ"
status: translated

[lang]
type: label

<lang-switch>
source: "切换语言"
target: "言語を切り替える"
status: translated

[meta]
type: sentence

<meta-title>
source: "CLIFF — 上下文，就是格式"
target: "CLIFF — 文脈が、フォーマット。"
status: translated

<meta-description>
source: "CLIFF 是一个上下文优先、逐行书写的本地化工作文件格式，覆盖完整本地化生命周期。译者读得懂，模型改得动，校验一次通过。"
target: "CLIFF は文脈を優先し、1 行ずつ書くローカライズ用ワークファイル形式です。ローカライズのライフサイクル全体をカバーします。翻訳者が読め、モデルが編集でき、検証は一度で通ります。"
status: translated

[cta]
type: label

<cta-heading-1>
source: "留住上下文。"
target: "文脈を残す。"
status: translated

<cta-heading-2>
source: "交付好翻译。"
target: "良い翻訳を届ける。"
status: translated

<cta-body>
source: "阅读 1.1 规范，选择一个实现，把真实的 CLIFF 文件送进校验器。"
target: "1.1 仕様を読み、実装をひとつ選び、実際の CLIFF ファイルをバリデータに通してください。"
type: description
status: translated

<cta-action-spec>
source: "阅读规范"
target: "仕様を読む"
status: translated

<cta-action-repos>
source: "浏览仓库"
target: "リポジトリを見る"
status: translated

[features]
type: label

<features-heading-1>
source: "一个工作格式，"
target: "作業用フォーマットであり、"
status: translated

<features-heading-2>
source: "而非交换容器。"
target: "交換用の入れ物ではない。"
status: translated

<features-lede>
source: "下面每个决定都有实测或规范支撑。格式本身携带上下文，翻译不必猜。"
target: "以下の判断はすべて実測か仕様に基づいています。文脈はフォーマット自体が持ち、翻訳は推測しません。"
type: description
status: translated

<features-context-title>
source: "上下文随行"
target: "文脈がついてくる"
status: translated

<features-context-body>
source: "家族、分组与条目的上下文会被继承。译者打开一个字符串时，知道自己在哪里、说给谁听、不能破坏什么。"
target: "クラン・グループ・エントリの文脈は継承されます。翻訳者が文字列を開くと、どこにあり、誰に向けた言葉で、何を壊してはいけないかが分かります。"
type: description
status: translated

<features-context-tag>
source: "家族 → 分组 → 条目"
target: "クラン → グループ → エントリ"
status: translated

<features-line-title>
source: "一行一个结构"
target: "1 行に 1 つの構造"
status: translated

<features-line-body>
source: "没有跨行开合标签。插入、移动或删除一行，都不会让文档留下未闭合的结构——人和模型都依赖这一点。"
target: "複数行にまたがる開始・終了タグはありません。行を挿入・移動・削除しても、閉じ忘れの構造は残りません。人もモデルもそれに依存しています。"
type: description
status: translated

<features-line-tag>
source: "单遍解析"
target: "単一パスで解析"
status: translated

<features-typed-title>
source: "该有类型的地方有类型"
target: "型があるべき場所に型がある"
status: translated

<features-typed-body>
source: "{type} 与 {status} 必填，封闭词表把含糊输入变成校验器能检查、工具链能信任的数据。"
target: "{type} と {status} は必須で、閉じた語彙が曖昧な入力を、バリデータが検査でき、ツールチェーンが信頼できるデータに変えます。"
type: description
status: translated

<features-typed-tag>
source: "封闭词表"
target: "閉じた語彙"
status: translated

<features-model-title>
source: "为模型编辑而生"
target: "モデルの編集のために"
status: translated

<features-model-body>
source: "宽容模式会修复模型真正会犯的错误，并逐条报告修复，而不是猜测。严格模式仍然拒绝语法拒绝的一切。"
target: "寛容モードはモデルが実際に犯す誤りを修復し、推測ではなく修復ごとに報告します。厳格モードは文法が拒否するものを依然として拒否します。"
type: description
status: translated

<features-model-tag>
source: "严格 + 宽容"
target: "厳格 + 寛容"
status: translated

<features-tokens-title>
source: "最低的 Token 账单"
target: "最小のトークン請求"
status: translated

<features-tokens-body>
source: "在相同上下文负载下，CLIFF 文档在十种被测格式中体积最小。短键名与无闭合标签会在每次调用中累积优势。"
target: "同じ文脈量なら、CLIFF 文書はテストした 10 形式の中で最も小さくなります。短いキー名と終了タグなしが、呼び出しのたびに効いてきます。"
type: description
status: translated

<features-tokens-tag>
source: "47,499 Token"
target: "47,499 トークン"
status: translated

<features-icu-title>
source: "ICU，原样保留"
target: "ICU をそのまま保持"
status: translated

<features-icu-body>
source: "MessageFormat 1 与 2 在引号值中逐字保留，方言自动识别，复杂复数和选择不再是特例。"
target: "MessageFormat 1 と 2 は引用値の中で逐語的に保たれ、方言は自動判定されます。複雑な複数形や選択も例外ではなくなります。"
type: description
status: translated

<features-icu-tag>
source: "MF1 + MF2"
target: "MF1 + MF2"
status: translated

