[hero]
type: label

<hero-announce>
source: "CLIFF 1.1 已发布"
target: "CLIFF 1.1 foi lançado"
status: translated

<hero-announce-link>
source: "阅读更新日志"
target: "Ler o registro de alterações"
status: translated

<hero-title-1>
source: "上下文，"
target: "O contexto,"
status: translated

<hero-title-2>
source: "就是格式。"
target: "é o formato."
status: translated

<hero-lede>
source: "一个面向完整本地化生命周期的逐行工作文件。家族、分组与条目的上下文随字符串流动——译者读得懂，模型改得动，校验一次通过。"
target: "Um arquivo de trabalho linha a linha para todo o ciclo de localização. O contexto de clã, grupo e entrada viaja com cada string: legível para tradutores, editável por modelos e validado em uma única passagem."
type: description
status: translated

<hero-action-spec>
source: "阅读规范"
target: "Ler a especificação"
status: translated

<hero-action-github>
source: "在 GitHub 查看"
target: "Ver no GitHub"
status: translated

<hero-proof-version>
source: "v1.1 稳定版"
target: "v1.1 estável"
status: translated

<hero-proof-license>
source: "MIT 许可"
target: "Licença MIT"
status: translated

<hero-proof-tested>
source: "与 10 种格式同场实测"
target: "Comparado com 10 formatos"
status: translated

<hero-figure-context>
source: "上下文保留"
target: "contexto preservado"
status: translated

<hero-figure-tokens>
source: "更少 Token"
target: "menos tokens"
status: translated

<hero-validated>
