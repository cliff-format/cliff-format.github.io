CLIFF 1.1
namespace: cliff
clan: site
source-language: zh-CN
target-language: zh-CN
title: "CLIFF site copy"

[nav]
type: label

<nav-brand-home>
source: "CLIFF 首页"
status: initial

<nav-main>
source: "主导航"
status: initial

<nav-format>
source: "格式"
status: initial

<nav-features>
source: "特性"
status: initial

<nav-lifecycle>
source: "生命周期"
status: initial

<nav-ecosystem>
source: "生态"
status: initial

<nav-github>
source: "在 GitHub 上查看 CLIFF"
status: initial

<nav-theme>
source: "深色模式"
status: initial

<nav-skip>
source: "跳到正文"
status: initial

[lang]
type: label

<lang-switch>
source: "切换语言"
status: initial

[meta]
type: sentence

<meta-title>
source: "CLIFF — 上下文，就是格式"
status: initial

<meta-description>
source: "CLIFF 是一个上下文优先、逐行书写的本地化工作文件格式，覆盖完整本地化生命周期。译者读得懂，模型改得动，校验一次通过。"
status: initial

[cta]
type: label

<cta-heading-1>
source: "留住上下文。"
status: initial

<cta-heading-2>
source: "交付好翻译。"
status: initial

<cta-body>
source: "阅读 1.1 规范，选择一个实现，把真实的 CLIFF 文件送进校验器。"
type: description
status: initial

<cta-action-spec>
source: "阅读规范"
status: initial

<cta-action-repos>
source: "浏览仓库"
status: initial

[features]
type: label

<features-heading-1>
source: "一个工作格式，"
status: initial

<features-heading-2>
source: "而非交换容器。"
status: initial

<features-lede>
source: "下面每个决定都有实测或规范支撑。格式本身携带上下文，翻译不必猜。"
type: description
status: initial

<features-context-title>
source: "上下文随行"
status: initial

<features-context-body>
source: "家族、分组与条目的上下文会被继承。译者打开一个字符串时，知道自己在哪里、说给谁听、不能破坏什么。"
type: description
status: initial

<features-context-tag>
source: "家族 → 分组 → 条目"
status: initial

<features-line-title>
source: "一行一个结构"
status: initial

<features-line-body>
source: "没有跨行开合标签。插入、移动或删除一行，都不会让文档留下未闭合的结构——人和模型都依赖这一点。"
type: description
status: initial

<features-line-tag>
source: "单遍解析"
status: initial

<features-typed-title>
source: "该有类型的地方有类型"
status: initial

<features-typed-body>
source: "{type} 与 {status} 必填，封闭词表把含糊输入变成校验器能检查、工具链能信任的数据。"
type: description
status: initial

<features-typed-tag>
source: "封闭词表"
status: initial

<features-model-title>
source: "为模型编辑而生"
status: initial

<features-model-body>
source: "宽容模式会修复模型真正会犯的错误，并逐条报告修复，而不是猜测。严格模式仍然拒绝语法拒绝的一切。"
type: description
status: initial

<features-model-tag>
source: "严格 + 宽容"
status: initial

<features-tokens-title>
source: "最低的 Token 账单"
status: initial

<features-tokens-body>
source: "在相同上下文负载下，CLIFF 文档在十种被测格式中体积最小。短键名与无闭合标签会在每次调用中累积优势。"
type: description
status: initial

<features-tokens-tag>
source: "47,499 Token"
status: initial

<features-icu-title>
source: "ICU，原样保留"
status: initial

<features-icu-body>
source: "MessageFormat 1 与 2 在引号值中逐字保留，方言自动识别，复杂复数和选择不再是特例。"
type: description
status: initial

<features-icu-tag>
source: "MF1 + MF2"
status: initial

