type: label

<hero-announce>
source: "CLIFF 1.1 已发布"
status: initial

<hero-announce-link>
source: "阅读更新日志"
status: initial

<hero-title-1>
source: "上下文，"
status: initial

<hero-title-2>
source: "就是格式。"
status: initial

<hero-lede>
source: "一个面向完整本地化生命周期的逐行工作文件。家族、分组与条目的上下文随字符串流动——译者读得懂，模型改得动，校验一次通过。"
type: description
status: initial

<hero-action-spec>
source: "阅读规范"
status: initial

<hero-action-github>
source: "在 GitHub 查看"
status: initial

<hero-proof-version>
source: "v1.1 稳定版"
status: initial

<hero-proof-license>
source: "MIT 许可"
status: initial

<hero-proof-tested>
source: "与 10 种格式同场实测"
status: initial

<hero-figure-context>
source: "上下文保留"
status: initial

<hero-figure-tokens>
source: "更少 Token"
