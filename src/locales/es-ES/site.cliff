[hero]
type: label

<hero-announce>
source: "CLIFF 1.1 已发布"
target: "CLIFF 1.1 ya está disponible"
status: translated

<hero-announce-link>
source: "阅读更新日志"
target: "Leer el registro de cambios"
status: translated

<hero-title-1>
source: "上下文，"
target: "El contexto,"
status: translated

<hero-title-2>
source: "就是格式。"
target: "es el formato."
status: translated

<hero-lede>
source: "一个面向完整本地化生命周期的逐行工作文件。家族、分组与条目的上下文随字符串流动——译者读得懂，模型改得动，校验一次通过。"
target: "Un archivo de trabajo línea a línea para todo el ciclo de localización. El contexto de clan, grupo y entrada viaja con cada cadena: legible para traductores, editable por modelos y validado de una sola pasada."
type: description
status: translated

<hero-action-spec>
source: "阅读规范"
target: "Leer la especificación"
status: translated

<hero-action-github>
source: "在 GitHub 查看"
target: "Ver en GitHub"
status: translated

<hero-proof-version>
source: "v1.1 稳定版"
target: "v1.1 estable"
status: translated

<hero-proof-license>
source: "MIT 许可"
target: "Licencia MIT"
status: translated

<hero-proof-tested>
source: "与 10 种格式同场实测"
target: "Comparado con 10 formatos"
status: translated

<hero-figure-context>
source: "上下文保留"
target: "contexto conservado"
status: translated

<hero-figure-tokens>
source: "更少 Token"
target: "menos tokens"
status: translated

<hero-validated>
