target: "v1.1 stable"
status: translated

<hero-proof-license>
source: "MIT 许可"
target: "Licence MIT"
status: translated

<hero-proof-tested>
source: "与 10 种格式同场实测"
target: "Comparé à 10 formats"
status: translated

<hero-figure-context>
