type: label

<nav-brand-home>
source: "CLIFF 首页"
target: "CLIFF home"
status: translated

<nav-main>
source: "主导航"
target: "Main navigation"
status: translated

<nav-format>
source: "格式"
target: "Format"
status: translated

<nav-features>
source: "特性"
target: "Features"
status: translated

<nav-lifecycle>
source: "生命周期"
target: "Lifecycle"
status: translated

<nav-ecosystem>
source: "生态"
target: "Ecosystem"
status: translated

<nav-github>
source: "在 GitHub 上查看 CLIFF"
target: "View CLIFF on GitHub"
status: translated

<nav-theme>
source: "深色模式"
target: "Dark mode"
status: translated

<nav-skip>
source: "跳到正文"
target: "Skip to content"
status: translated

[lang]
type: label

<lang-switch>
source: "切换语言"
target: "Switch language"
status: translated

[meta]
type: sentence

<meta-title>
source: "CLIFF — 上下文，就是格式"
target: "CLIFF — context is the format"
status: translated

<meta-description>
source: "CLIFF 是一个上下文优先、逐行书写的本地化工作文件格式，覆盖完整本地化生命周期。译者读得懂，模型改得动，校验一次通过。"
target: "CLIFF is a context-first, line-oriented working file format for localization that covers the whole localization lifecycle. Readable by translators, editable by models, validated in one pass."
status: translated

[cta]
type: label

<cta-heading-1>
source: "留住上下文。"
target: "Keep the context."
status: translated

<cta-heading-2>
source: "交付好翻译。"
target: "Ship good translations."
status: translated

<cta-body>
source: "阅读 1.1 规范，选择一个实现，把真实的 CLIFF 文件送进校验器。"
target: "Read the 1.1 specification, pick an implementation, and send a real CLIFF file through the validator."
type: description
status: translated

<cta-action-spec>
source: "阅读规范"
target: "Read the spec"
status: translated

<cta-action-repos>
source: "浏览仓库"
target: "Browse the repos"
status: translated

[features]
type: label

<features-heading-1>
source: "一个工作格式，"
target: "A working format,"
status: translated

<features-heading-2>
source: "而非交换容器。"
target: "not an exchange container."
status: translated

<features-lede>
source: "下面每个决定都有实测或规范支撑。格式本身携带上下文，翻译不必猜。"
target: "Every decision below is backed by a measurement or the specification. The format carries the context, so translation does not have to guess."
type: description
status: translated

<features-context-title>
source: "上下文随行"
target: "Context travels"
status: translated

<features-context-body>
source: "家族、分组与条目的上下文会被继承。译者打开一个字符串时，知道自己在哪里、说给谁听、不能破坏什么。"
target: "Clan, group, and entry context is inherited. When a translator opens a string, they know where it lives, who it speaks to, and what must not break."
type: description
status: translated

<features-context-tag>
source: "家族 → 分组 → 条目"
target: "clan → group → entry"
status: translated

<features-line-title>
source: "一行一个结构"
target: "One line, one structure"
status: translated

<features-line-body>
source: "没有跨行开合标签。插入、移动或删除一行，都不会让文档留下未闭合的结构——人和模型都依赖这一点。"
target: "No multi-line open and close tags. Inserting, moving, or deleting a line never leaves an unclosed structure behind — people and models both depend on that."
type: description
status: translated

<features-line-tag>
source: "单遍解析"
target: "single-pass parse"
status: translated

<features-typed-title>
source: "该有类型的地方有类型"
target: "Types where types belong"
status: translated

<features-typed-body>
source: "{type} 与 {status} 必填，封闭词表把含糊输入变成校验器能检查、工具链能信任的数据。"
target: "{type} and {status} are required; closed vocabularies turn ambiguous input into data a validator can check and a toolchain can trust."
type: description
status: translated

<features-typed-tag>
source: "封闭词表"
target: "closed vocabularies"
status: translated

<features-model-title>
source: "为模型编辑而生"
target: "Built for model edits"
status: translated

<features-model-body>
source: "宽容模式会修复模型真正会犯的错误，并逐条报告修复，而不是猜测。严格模式仍然拒绝语法拒绝的一切。"
target: "Tolerant mode repairs the mistakes models actually make and reports every repair instead of guessing. Strict mode still rejects everything the grammar rejects."
type: description
status: translated

<features-model-tag>
source: "严格 + 宽容"
target: "strict + tolerant"
status: translated

<features-tokens-title>
source: "最低的 Token 账单"
target: "The lowest token bill"
status: translated

<features-tokens-body>
source: "在相同上下文负载下，CLIFF 文档在十种被测格式中体积最小。短键名与无闭合标签会在每次调用中累积优势。"
target: "At the same context load, CLIFF documents are the smallest of the ten formats tested. Short keys and no closing tags compound on every call."
type: description
status: translated

<features-tokens-tag>
source: "47,499 Token"
target: "47,499 tokens"
status: translated

<features-icu-title>
source: "ICU，原样保留"
target: "ICU, preserved verbatim"
status: translated

<features-icu-body>
source: "MessageFormat 1 与 2 在引号值中逐字保留，方言自动识别，复杂复数和选择不再是特例。"
target: "MessageFormat 1 and 2 are preserved verbatim inside quoted values, the dialect is detected automatically, and complex plurals and selects stop being special cases."
type: description
status: translated

<features-icu-tag>
source: "MF1 + MF2"
target: "MF1 + MF2"
status: translated

