---
interface Props {
  name: keyof typeof icons;
  class?: string;
}

const defaults = { stroke: "currentColor", strokeWidth: "1.7", fill: "none" } as const;

const icons = {
  github: {
    fill: "currentColor",
    stroke: "none",
    body: '<path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.94.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.15-3.02-.11-.29-.5-1.43.11-2.98 0 0 .94-.3 3.09 1.15a10.7 10.7 0 0 1 5.63 0c2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.23 2.69.11 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.63 5.26-5.14 5.54.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z"/>',
  },
  arrowRight: { body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  file: {
    body: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/>',
  },
  check: { strokeWidth: "2", body: '<path d="m5 12.5 4.2 4.2L19 7"/>' },
  layers: {
    body: '<path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12 8 4.5 8-4.5"/><path d="m4 16.5 8 4.5 8-4.5"/>',
  },
  lines: { body: '<path d="M4 6h16M4 11h11M4 16h7"/><path d="m15 14 4 4-4 1 1-4"/>' },
  tag: {
    body: '<path d="M20.6 13.6 13.6 20.6a2 2 0 0 1-2.8 0L3 12.8V3h9.8l7.8 7.8a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
  },
  sparkle: {
    body: '<path d="m12 3 1.7 5.5L19 10l-5.3 1.5L12 17l-1.7-5.5L5 10l5.3-1.5L12 3Z"/><path d="m18.7 15 .8 2.3 2.3.7-2.3.8-.8 2.2-.8-2.2-2.2-.8 2.2-.7.8-2.3Z"/>',
  },
  database: {
    body: '<ellipse cx="12" cy="6.5" rx="7" ry="3"/><path d="M5 6.5v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/><path d="M5 11.5v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/>',
  },
  code: {
    body: '<path d="M8 4H6a2 2 0 0 0-2 2v3a2 2 0 0 1-2 2 2 2 0 0 1 2 2v3a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v3a2 2 0 0 0 2 2 2 2 0 0 0-2 2v3a2 2 0 0 1-2 2h-2"/>',
  },
  trend: { strokeWidth: "1.8", body: '<path d="M4 17 10 11l4 4 6-7"/><path d="M15 8h5v5"/>' },
  sun: {
    body: '<circle cx="12" cy="12" r="4.1"/><path d="M12 2.4v2.1M12 19.5v2.1M2.4 12h2.1M19.5 12h2.1M5.2 5.2l1.5 1.5M17.3 17.3l1.5 1.5M18.8 5.2l-1.5 1.5M6.7 17.3l-1.5 1.5"/>',
  },
  moon: { body: '<path d="M20.2 14.1A8.4 8.4 0 0 1 9.9 3.8a8.6 8.6 0 1 0 10.3 10.3Z"/>' },
  copy: {
    body: '<rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M15 5.5A2.5 2.5 0 0 0 12.5 3H6a3 3 0 0 0-3 3v6.5A2.5 2.5 0 0 0 5.5 15"/>',
  },
} satisfies Record<string, { body: string; fill?: string; stroke?: string; strokeWidth?: string }>;

const { name, class: className = "ico" } = Astro.props;
const icon = icons[name];
const fill = "fill" in icon && icon.fill ? icon.fill : defaults.fill;
const stroke = "stroke" in icon && icon.stroke ? icon.stroke : defaults.stroke;
const strokeWidth = "strokeWidth" in icon && icon.strokeWidth ? icon.strokeWidth : defaults.strokeWidth;
---

<svg data-icon={name}
  class={className}
  viewBox="0 0 24 24"
  fill={fill}
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icon.body}
/>