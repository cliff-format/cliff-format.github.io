---
import { t, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const steps = ["extract", "translate", "review", "deliver"] as const;
---

<section class="section lifecycle" id="lifecycle">
  <div class="wrap">
    <div class="section-head">
      <h2>{t(locale, "lifecycle-heading-1")}<br /><em>{t(locale, "lifecycle-heading-2")}</em></h2>
      <p class="section-lede">{t(locale, "lifecycle-lede")}</p>
    </div>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step-num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{t(locale, `lifecycle-${step}-title`)}</h3>
            <p>{t(locale, `lifecycle-${step}-body`)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
