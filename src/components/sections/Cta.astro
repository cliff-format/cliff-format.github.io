---
import Icon from "../Icon.astro";
import GlassButton from "../GlassButton.astro";
import LiquidGlass from "../../lib/liquid-glass/LiquidGlass.astro";
import { t, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="cta wrap">
  <LiquidGlass class="cta-panel pane" radius={40} depth={10} blur={3}>
    <div class="cta-surface pane-surface">
      <h2>{t(locale, "cta-heading-1")}<br /><em>{t(locale, "cta-heading-2")}</em></h2>
      <p class="cta-copy">{t(locale, "cta-body")}</p>
      <div class="actions">
        <GlassButton brand>
          <a
            class="btn btn-primary"
            href="https://github.com/cliff-format/cliff/blob/main/spec/cliff-1.1.0.md"
            target="_blank"
            rel="noreferrer"
          >
            <span class="btn__label">{t(locale, "cta-action-spec")}</span>
            <Icon name="arrowRight" />
          </a>
        </GlassButton>
        <GlassButton>
          <a class="btn btn-ghost" href="https://github.com/cliff-format" target="_blank" rel="noreferrer">
            <span class="btn__label">{t(locale, "cta-action-repos")}</span>
          </a>
        </GlassButton>
      </div>
    </div>
  </LiquidGlass>
</section>