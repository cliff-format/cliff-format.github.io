---
// Random glyphs from the ten site languages form the decorative text weave.
// The field is rotated -20deg in graphite.css and the rows alternate direction.
const GLYPHS = [
  ..."ŞÜÆĘØŒĞĄÅÑÇß",
  ..."シコあカナタハマヤラワ国日本語文字翻訳",
  ..."번국한글역문자언어",
  ..."ЩГДЖЯФЦЮБЭЫ",
  ..."家族分組條目上下文格式境文化譯",
  ..."ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
];

function seeded(seed: number): () => number {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// The field moves 8.5–29 px/s. Twenty samples a second keep the fastest
// visible row under 1.5 px per step and stop the glass backdrop from
// re-rasterizing on every display frame; the drift still reads as continuous.
const DRIFT_FPS = 20;

const random = seeded(0xc11ff);
const rows = Array.from({ length: 80 }, (_, row) => {
  const length = 44 + (row % 4) * 6;
  const text = Array.from({ length }, () => GLYPHS[Math.floor(random() * GLYPHS.length)]).join("");
  // Four repeats keep one copy wider than the 4K field. The fixed-cell font
  // gives every glyph the same advance, so plain text keeps the 1.636em grid
  // without spans.
  return text.repeat(4);
});
---

<div class="bd-text" aria-hidden="true" dir="ltr">
  {
    rows.map((text, index) => {
      const duration = 260 + index * 10;
      return (
        <div class="text-row" style={`--dur:${duration}s;--drift-steps:${duration * DRIFT_FPS}`}>
          <div class="text-track">
            <span class="text-copy">{text}</span>
            <span class="text-copy" aria-hidden="true">{text}</span>
          </div>
        </div>
      );
    })
  }
</div>
